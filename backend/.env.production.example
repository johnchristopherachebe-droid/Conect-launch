# Copy to .env.production and fill in. Never commit the real file.
DOMAIN=api.yourdomain.com
DB_PASSWORD=use-a-long-random-password
NODE_ENV=production
PORT=3000
JWT_SECRET=paste-output-of-openssl-rand-hex-32
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
OPAY_ENV=live
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_PRIVATE_KEY=
PUBLIC_URL=https://api.yourdomain.com
FIREBASE_SERVICE_ACCOUNT=/app/firebase-service-account.json
# For Vercel, set FIREBASE_SERVICE_ACCOUNT_JSON as a secret env var containing the service-account JSON.
# Generate once with openssl rand -hex 32. Store as a secret and back it up securely.
DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# Email verification (Resend). Verify your sender/domain in Resend before production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Cönëct <verify@your-verified-domain.com>
