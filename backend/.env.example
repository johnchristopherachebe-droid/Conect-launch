PORT=3000
DATABASE_URL=postgres://conect:conect@localhost:5432/conect
JWT_SECRET=change-me-to-a-long-random-string
# Set true only for a disposable development database; otherwise migrations create no fake stores/products.
SEED_DEMO_DATA=false

# Paystack: Settings > API Keys & Webhooks. Use the TEST secret key (sk_test_...) until you go live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
OPAY_ENV=test
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_PRIVATE_KEY=
# Public address of this server, used for Paystack's redirect after payment.
# Locally, a tunnel such as ngrok gives you one (e.g. https://abc123.ngrok-free.app).
PUBLIC_URL=http://localhost:3000

# Firebase push notifications (optional). Path to the service-account JSON downloaded from
# Firebase console > Project settings > Service accounts. Never commit this file.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# On Vercel, use FIREBASE_SERVICE_ACCOUNT_JSON as a secret environment variable containing the JSON instead of a file path.

# Distance pricing in NGN; distance-based fee applies when both store and address GPS are saved.
# Initial fallback defaults only; once migrated, the admin Settings screen controls delivery fees.
DELIVERY_BASE_FEE=300
DELIVERY_PER_KM=180
DELIVERY_MIN_FEE=300

# Encrypts private identity/business documents before PostgreSQL storage. Generate once with: openssl rand -hex 32
# Keep this secret backed up securely; losing it makes uploaded documents unrecoverable. Never commit a real key.
DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# Email verification (Resend). Verify your sender/domain in Resend before production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Cönëct <verify@your-verified-domain.com>
